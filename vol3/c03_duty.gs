// 第3章：日直・当番を自動で回す（第2章のコードが必要です）
// 「設定」シートに、「当番の基準日」（例：2026/4/6）と、「日直の人数」（空欄なら2）を入れます。
// 「休み」シート：見出しは「日付」。学校が休みの日（祝日・休業日）を並べます。土日は入れなくて構いません。

// 授業のある日（土日と休みを除く日）かどうかを調べます。
function 授業日か_(文字, 休み一覧) {
  const 曜 = 曜日の文字_(文字);
  if (曜 === '土' || 曜 === '日') return false;
  return 休み一覧.indexOf(文字) < 0;
}

// 基準日から今日の前日までに、授業日が何日あったかを数えます（当番の順番になります）。
function 授業日の通し番号_(基準日, 今日, 休み一覧) {
  const 日数 = 日数の差_(基準日, 今日);
  if (日数 < 0) throw new Error('当番の基準日が、今日より後になっています。設定シートを確かめてください。');
  let 数 = 0;
  for (let i = 0; i < 日数; i++) {
    if (授業日か_(日付に足す_(基準日, i), 休み一覧)) 数++;
  }
  return 数;
}

// 名簿の順に、人数ぶんずつ回して、きょうの当番を選びます。名簿の最後まで来たら、最初にもどります。
function 当番を選ぶ_(人, 通し番号, 人数) {
  const 結果 = [];
  for (let i = 0; i < 人数 && i < 人.length; i++) {
    結果.push(人[(通し番号 * 人数 + i) % 人.length]);
  }
  return 結果;
}

function 休みの一覧を読む_() {
  const シート = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('休み');
  if (!シート) return [];
  return 表を読む_(シート).map(function (r) {
    return 日付の文字にする_(r['日付']);
  });
}

// きょうの当番を、「今日の当番」シートに書きます（自動で動かす仕事の本体）。
function 今日の当番の仕事() {
  仕事を実行する_('今日の当番', function () {
    const 今日 = 今日の文字_();
    const 基準日 = 日付の文字にする_(設定を読む_('当番の基準日', ''));
    if (基準日 === '') throw new Error('設定シートに、「当番の基準日」を入れてください。');
    const 休み = 休みの一覧を読む_();
    if (!授業日か_(今日, 休み)) return '授業日ではないので、何もしませんでした';
    const 通し番号 = 授業日の通し番号_(基準日, 今日, 休み);
    const 当番 = 当番を選ぶ_(名簿を読む_(), 通し番号, Number(設定を読む_('日直の人数', 2)));
    const 表 = [[日付の表示にする_(今日) + ' の日直'], ['番号', '氏名']];
    当番.forEach(function (p) {
      表.push([p['番号'], p['氏名']]);
    });
    出力シートを用意する_('今日の当番').getRange(1, 1, 表.length, 2).setValues(表.map(function (r) { return r.length === 1 ? [r[0], ''] : r; }));
    return 当番.map(function (p) { return p['氏名']; }).join('・');
  });
}

function 当番の自動実行を作る() {
  自動実行を作る_('今日の当番の仕事', '毎日', Number(設定を読む_('朝の時刻', 7)));
}
