// 第5章：未提出者へのリマインド（第2・4章のコードと、上の共通部品が必要です）

// 回答がまだの人（名簿の行）を返します。
function 未提出者を取り出す_() {
  const 人 = 名簿を読む_();
  const 見出し = String(設定を読む_('番号の見出し', '番号'));
  const 結果 = 提出状況を調べる_(人, 表を読む_(回答シートを取る_()), 見出し, 'タイムスタンプ');
  const 未提出の番号 = 結果.一覧
    .filter(function (x) { return !x.提出; })
    .map(function (x) { return x.番号; });
  return 人.filter(function (p) {
    return 未提出の番号.indexOf(p['番号']) >= 0;
  });
}

// 未提出の人の保護者へ、リマインドのメールを送ります。送る前に、必ず確認の画面を出します。
function リマインドを送る() {
  const ui = SpreadsheetApp.getUi();
  const 未提出 = 未提出者を取り出す_();
  if (未提出.length === 0) {
    ui.alert('未提出の人はいません。');
    return;
  }
  const 件名 = String(設定を読む_('リマインド件名', '【お願い】フォームのご回答がまだです'));
  const 本文の型 = String(
    設定を読む_(
      'リマインド本文',
      '{{氏名}} さんの保護者様\n\nフォームのご回答が、まだ確認できておりません。\nお手数ですが、ご回答をお願いいたします。\n\nすでにご回答済みの場合は、失礼をお許しください。'
    )
  );
  const 送る人 = 未提出.filter(function (p) { return 宛先として正しい_(p['保護者メール']); });
  const メールなし = 未提出.length - 送る人.length;

  送れる数を確かめる_(送る人.length);
  const モード = 送信モード_();
  const 説明 = モード === '本番'
    ? '【本番】' + 送る人.length + '人の保護者に、本当に送ります。'
    : '【テスト】自分あてに ' + 送る人.length + '通だけ届きます（保護者には届きません）。';
  const 答え = ui.alert('確認', 説明 + '\nメールアドレスがなく、送れない人：' + メールなし + '人\n\nよろしいですか？', ui.ButtonSet.YES_NO);
  if (答え !== ui.Button.YES) return;

  let 送った = 0;
  let 飛ばした = 0;
  送る人.forEach(function (p) {
    const 宛先 = String(p['保護者メール']).trim();
    if (すでに送った_('リマインド', 宛先, 件名)) {
      飛ばした++;
      return;
    }
    メールを送る_(宛先, 件名, 差し込む_(本文の型, p));
    送信を記録する_('リマインド', 宛先, 件名);
    送った++;
  });
  ui.alert('終わりました。\n送った：' + 送った + '通\nすでに送ってあり、飛ばした：' + 飛ばした + '通');
}
