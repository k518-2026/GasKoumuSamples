// 第15章：保護者への一斉メール（第2章の共通部品と、第5章の「メールを送る共通部品」が必要です）
// 「設定」シートに、「メール件名」と「メール本文」を入れます。本文には、「{{氏名}}」のような差し込みが使えます。
// 「送信モード」が「本番」でなければ、すべて自分あてに送られます（第5章）。

// 送る前の確認に出す、先頭の数通の見本を作ります。
function メールの見本を作る_(人, 件名, 本文の型, 通数) {
  return 人.slice(0, 通数).map(function (p) {
    return '宛先：' + p['保護者メール'] + '\n件名：' + 件名 + '\n' + 差し込む_(本文の型, p);
  });
}

function 一斉メールを送る() {
  const ui = SpreadsheetApp.getUi();
  const 件名 = String(設定を読む_('メール件名', ''));
  const 本文の型 = String(設定を読む_('メール本文', ''));
  if (件名 === '' || 本文の型 === '') throw new Error('設定シートに、「メール件名」と「メール本文」を入れてください。');

  const 全員 = 名簿を読む_();
  const 送る人 = 全員.filter(function (p) { return 宛先として正しい_(p['保護者メール']); });
  const 送れない = 全員.length - 送る人.length;
  送れる数を確かめる_(送る人.length);

  const モード = 送信モード_();
  const 見本 = メールの見本を作る_(送る人, 件名, 本文の型, 2).join('\n――――――\n');
  const 説明 = モード === '本番'
    ? '【本番】' + 送る人.length + '人の保護者に、本当に送ります。'
    : '【テスト】自分あてに ' + 送る人.length + '通だけ届きます（保護者には届きません）。';
  const 答え = ui.alert('送る前の確認', 説明 + '\nアドレスがなく送れない人：' + 送れない + '人\n\n▼見本（先頭の2通）\n' + 見本 + '\n\nよろしいですか？', ui.ButtonSet.YES_NO);
  if (答え !== ui.Button.YES) return;

  let 送った = 0;
  let 飛ばした = 0;
  送る人.forEach(function (p) {
    const 宛先 = String(p['保護者メール']).trim();
    if (すでに送った_('一斉メール', 宛先, 件名)) {
      飛ばした++;
      return;
    }
    メールを送る_(宛先, 件名, 差し込む_(本文の型, p));
    送信を記録する_('一斉メール', 宛先, 件名);
    送った++;
  });
  ui.alert('終わりました。\n送った：' + 送った + '通\nすでに送ってあり、飛ばした：' + 飛ばした + '通');
}
